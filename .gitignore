# skip DRM output, graphics, csv's
# (except one file, used for a quick webserver status check)
# (the ! is ineffectual for a dir that was fully excluded...
# this is here just for book-keeping that this file is part
# of the repository...commit it with -f)
sims
!sims/heartbeat.html

# skip focused analysis/experiments/results
Analyses

# skip EXOSIMS source code, if any
EXOSIMS

# skip ipyparallel per-user config (obsolete, but existing in some places)
ipyparallel/*

# uv lock files
# (but the doc build's lock is tracked: pyproject.toml pins mkdocs deliberately,
# and only the *ranges* survive a clone without it)
uv.lock
!util/doc_sandbox/uv.lock

# uv cache directories
.uv_cache

# python byte-compiled files
__pycache__
*.pyc

# vi backup files
*~
# emacs tempfiles
\#*\#

# mac metadata files (sometimes _. is doubled)
.*DS_Store

# network file system (NFS) hidden files
.nfs*

# exclude web server log files, except the README placeholder
Local/www-service/var/*
!Local/www-service/var/README.txt

# generated files, except for README.txt placeholder
Local/www-resources/doc/*
!Local/www-resources/doc/README.txt

# localized sandbox name file
Local/config-sandbox.json

# documentation - generated files
util/doc_sandbox/site
# note: docs/impl_index.md and docs/implementation/* are hand-maintained
# (since 2026/05) and are tracked -- mkdocs.yml names them in the nav

# generated files above are placed here for www service
# (but leave the README placeholder)
Local/www-resources/doc_sandbox/*
!Local/www-resources/doc_sandbox/README.txt

# remove the scripts from source control
# (except one file, to allow recursive Make to work)
# (the ! is ineffectual for a dir that was fully excluded...
# this is here just for book-keeping that this file is part
# of the repository...commit it with -f)
Scripts
!Scripts/sims.json

